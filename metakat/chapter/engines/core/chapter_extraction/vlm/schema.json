{
  "type": "object",
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tocPage": {
            "type": "integer",
            "minimum": 0
          },
          "level": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "heading",
              "item"
            ]
          },
          "partNumber": {
            "type": [
              "string",
              "null"
            ]
          },
          "designation": {
            "type": [
              "string",
              "null"
            ]
          },
          "titleInfo": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "subTitle": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "description": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "lang": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/languageCode"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "translated": {
                  "type": "boolean"
                }
              },
              "required": [
                "title",
                "subTitle",
                "description",
                "lang",
                "translated"
              ],
              "additionalProperties": false
            }
          },
          "agents": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "author",
                    "illustrator",
                    "photographer",
                    "translator",
                    "editor",
                    "composer",
                    "reviewer",
                    "issuingBody",
                    "contributor",
                    "other"
                  ]
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "personal",
                    "corporate",
                    "conference",
                    "family"
                  ]
                },
                "name": {
                  "type": "string"
                },
                "termsOfAddress": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "dates": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "description": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "affiliation": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "role",
                "type",
                "name",
                "termsOfAddress",
                "dates",
                "description",
                "affiliation"
              ],
              "additionalProperties": false
            }
          },
          "etal": {
            "type": [
              "string",
              "null"
            ]
          },
          "pageReference": {
            "type": [
              "string",
              "null"
            ]
          },
          "pages": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "properties": {
                    "start": {
                      "type": "string"
                    },
                    "end": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "start",
                    "end"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "tocPage",
          "level",
          "kind",
          "partNumber",
          "designation",
          "titleInfo",
          "agents",
          "etal",
          "pageReference",
          "pages"
        ],
        "additionalProperties": false
      }
    }
