{
  "type": "object",
  "properties": {
    "titleInfo": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "subTitle": {
            "type": [
              "string",
              "null"
            ]
          },
          "parts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "level": {
                  "type": "integer",
                  "enum": [
                    1,
                    2,
                    3
                  ]
                },
                "partNumber": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "partName": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "level",
                "partNumber",
                "partName"
              ],
              "additionalProperties": false
            }
          },
          "lang": {
            "anyOf": [
              {
                "$ref": "#/$defs/languageCode"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "title",
          "subTitle",
          "parts",
          "lang"
        ],
        "additionalProperties": false
      }
    },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "seriesName": {
            "type": [
              "string",
              "null"
            ]
          },
          "seriesPartNumber": {
            "type": [
              "string",
              "null"
            ]
          },
          "seriesPartName": {
            "type": [
              "string",
              "null"
            ]
          },
          "seriesIssn": {
            "type": [
              "string",
              "null"
            ]
          },
