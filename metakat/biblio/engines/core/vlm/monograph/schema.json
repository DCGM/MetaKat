        "required": [
          "placeTerm",
          "publisher",
          "publisherInferred",
          "dateIssued",
          "edition"
        ],
        "additionalProperties": false
      }
    },
    "manufacture": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "manufacturePlaceTerm": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "manufacturePublisher": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "manufactureDate": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "manufacturePlaceTerm",
          "manufacturePublisher",
          "manufactureDate"
        ],
        "additionalProperties": false
      }
    },
    "distribution": {
      "type": "array",
