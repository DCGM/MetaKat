          "distributionPlaceTerm": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "distributor": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "distributionDate": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "distributionPlaceTerm",
          "distributor",
          "distributionDate"
        ],
        "additionalProperties": false
      }
    },
    "copyrightDate": {
      "type": [
        "string",
        "null"
      ]
    },
    "isbn": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "illustrativeContent": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "language": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/languageCode"
      }
    },
    "originalLanguage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/languageCode"
      }
    }
  },
  "required": [
    "titleInfo",
    "series",
    "statementOfResponsibility",
