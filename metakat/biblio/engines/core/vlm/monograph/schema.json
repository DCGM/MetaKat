          "seriesName",
          "seriesPartNumber",
          "seriesPartName",
          "seriesIssn",
          "seriesEditor",
          "lang"
        ],
        "additionalProperties": false
      }
    },
    "statementOfResponsibility": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "author",
              "illustrator",
              "photographer",
              "translator",
              "editor",
              "composer",
              "reviewer",
              "issuingBody",
              "contributor",
              "other"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "personal",
              "corporate",
              "conference",
              "family"
            ]
          },
          "name": {
            "type": "string"
          },
          "termsOfAddress": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "role",
          "type",
          "name",
          "termsOfAddress",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "etal": {
      "type": [
        "string",
        "null"
      ]
    },
    "publication": {
